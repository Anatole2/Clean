{% extends 'base.html.twig' %}

{% block title %}Abonnement Ajouté{% endblock %}

{% block body %}
<main class="container">
    <article>
        <header style="text-align: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#2ecc71" viewBox="0 0 16 16" style="margin-bottom: 1rem;">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
            </svg>
            
            <hgroup>
                <h2>Abonnement créé !</h2>
                <h3>Opération réussie</h3>
            </hgroup>
        </header>

        <p style="text-align: center;">
            La nouvelle offre d'abonnement a été ajoutée avec succès à votre parking.<br>
            Elle est désormais visible par les conducteurs qui souhaitent souscrire.
        </p>

        <footer class="grid">
            <a role="button" href="/dashboard">
                Retour au dashboard
            </a>
            
            <a role="button" class="secondary" href="/parkings/{{ parkingId }}/plans/new">
                + Ajouter une autre offre
            </a>
        </footer>
    </article>
</main>
{% endblock %}
