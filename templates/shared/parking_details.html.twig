{% extends "base.html.twig" %}

{% block title %}{{ parking.name }}{% endblock %}

{% block body %}
<div class="container">
    <header style="margin-bottom: 2rem;">
        <h1>🅿️ {{ parking.name }}</h1>
        <p>📍 {{ parking.totalPlaces }} places disponibles</p>
    </header>

    <div class="grid">
        <article>
            <h3 style="margin-bottom: 0.5rem;">🕒 Horaires d'ouverture</h3>
            
            {% set rules = parking.openingHours.toArray %}
            
            {% if rules is empty %}
                <div style="padding: 1rem; background-color: #e6fffa; color: #20c997; border-radius: 8px; margin-bottom: 2rem;">
                    <strong>✅ Ouvert 24h/24 et 7j/7</strong>
                </div>
            {% else %}
                <table role="grid" style="margin-bottom: 2rem; font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th>Jour</th>
                            <th>Créneau</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# Mapping des jours (1=Lundi, etc.) #}
                        {% set days = {
                            1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 
                            4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi', 7: 'Dimanche'
                        } %}

                        {% for rule in rules %}
                            <tr>
                                <td>{{ days[rule.startDay] }}</td>
                                <td>
                                    {{ rule.startTime }} ➝ 
                                    {% if rule.startDay != rule.endDay %}
                                        {{ days[rule.endDay] }} 
                                    {% endif %}
                                    {{ rule.endTime }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}


            <h3 style="margin-bottom: 0.5rem;">💶 Grille Tarifaire</h3>
            
            {% set prices = parking.priceGrid.toArray %}
            
            {% if prices is empty %}
                <p><em>Aucun tarif renseigné.</em></p>
            {% else %}
                <table role="grid" style="font-size: 0.9rem;">
                    <thead>
                        <tr>
                            <th>Durée</th>
                            <th>Prix</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# On suppose que prices est sous la forme [minutes => prix_centimes] #}
                        {# On trie par durée pour que ce soit logique #}
                        {% for minutes, price in prices %}
                            <tr>
                                <td>
                                    {% if minutes < 60 %}
                                        {{ minutes }} min
                                    {% else %}
                                        {{ minutes / 60 }}h
                                    {% endif %}
                                </td>
                                <td><strong>{{ price / 100 }} €</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <small style="color: grey;">* Prix indiqués à titre indicatif.</small>
            {% endif %}
        </article>

        <div>
            <article>
                <header><strong>Besoin d'une place maintenant ?</strong></header>
                <p>Réservez votre créneau horaire à l'avance.</p>
                <a href="/reservation/new?parkingId={{ parking.id }}" role="button">
                    📅 Réserver une place
                </a>
            </article>

            <article>
                <header><strong>Résident ou travailleur ?</strong></header>
                <p>Découvrez nos forfaits mensuels.</p>
                
                {% if parking.subscriptionPlans is not empty %}
                    <ul>
                    {% for plan in parking.subscriptionPlans %}
                        <li>{{ plan.name }} : <strong>{{ plan.monthlyPrice / 100 }} €</strong> / mois</li>
                    {% endfor %}
                    </ul>
                    <a href="/subscription/new?parkingId={{ parking.id }}" role="button" class="secondary">
                        ⭐ S'abonner
                    </a>
                {% else %}
                    <p><em>Pas d'abonnements disponibles pour ce parking.</em></p>
                {% endif %}
            </article>
        </div>
    </div>
</div>
{% endblock %}
