# Configuration du projet
PROJECT_NAME=sharedParking

# CHOIX DU STOCKAGE (mysql ou mongodb)
DB_CONNECTION=mysql

# Configuration des ports
APP_PORT=8080   # Port pour l'application PHP (http://localhost:8080)
PMA_PORT=8081   # Port pour phpMyAdmin (http://localhost:8081)
MYSQL_PORT=3306 # Port pour l'accès direct à MySQL (souvent non nécessaire)

# Configuration de la base de données (Secrets)

# Mot de passe root pour MySQL (utilisé par phpMyAdmin pour l'accès root et par le service MySQL lui-même)
MYSQL_ROOT_PASSWORD=root

# Identifiants de l'utilisateur de l'application (utilisé par PHP et par MySQL pour la création)
MYSQL_DATABASE=SharedParking
MYSQL_USER=user
MYSQL_PASSWORD=user

# Identifiants pour la base de données de test (utilisé par PHP pour les tests)
MYSQL_TEST_DATABASE=sharedParkingTest

# --- MONGODB ---
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root
MONGO_DATABASE=parking_db_mongo
MONGO_TEST_DATABASE=parking_db_mongo_test

# Secret pour la génération des JWT (utilisé par PHP pour l'authentification)
JWT_SECRET=your_jwt_secret_key_here
